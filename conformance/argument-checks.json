{
  "_about": "Tool input schemas, arguments as a client sent them, and the top-level argument names every SDK must find refused (contract, 3.10). Only a name the schema declares is ever named.",
  "cases": [
    {
      "case": "arguments that match the schema",
      "schema": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string"
          },
          "passengers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "destination",
          "passengers"
        ]
      },
      "arguments": {
        "destination": "LIS",
        "passengers": [
          "Ada",
          "Alan"
        ]
      },
      "invalid": []
    },
    {
      "case": "a count where the schema wants a list of names",
      "schema": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string"
          },
          "passengers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "destination",
          "passengers"
        ]
      },
      "arguments": {
        "destination": "LIS",
        "passengers": 2
      },
      "invalid": [
        "passengers"
      ]
    },
    {
      "case": "a required argument left out",
      "schema": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string"
          },
          "passengers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "destination",
          "passengers"
        ]
      },
      "arguments": {
        "passengers": [
          "Ada"
        ]
      },
      "invalid": [
        "destination"
      ]
    },
    {
      "case": "no arguments at all, as null",
      "schema": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string"
          },
          "passengers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "destination",
          "passengers"
        ]
      },
      "arguments": null,
      "invalid": [
        "destination",
        "passengers"
      ]
    },
    {
      "case": "arguments that are not an object give no names",
      "schema": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string"
          },
          "passengers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "destination",
          "passengers"
        ]
      },
      "arguments": [
        "LIS",
        2
      ],
      "invalid": []
    },
    {
      "case": "an argument the schema does not have is never named",
      "schema": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string"
          },
          "passengers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "destination",
          "passengers"
        ],
        "additionalProperties": false
      },
      "arguments": {
        "destination": "LIS",
        "passengers": [
          "Ada"
        ],
        "secret-4412": true
      },
      "invalid": []
    },
    {
      "case": "a name in required that properties do not describe is still the schema's",
      "schema": {
        "type": "object",
        "required": [
          "date"
        ]
      },
      "arguments": {},
      "invalid": [
        "date"
      ]
    },
    {
      "case": "every type, each matched",
      "schema": {
        "type": "object",
        "properties": {
          "seats": {
            "type": "integer"
          },
          "price": {
            "type": "number"
          },
          "window": {
            "type": "boolean"
          },
          "note": {
            "type": "null"
          },
          "tags": {
            "type": "array"
          },
          "filters": {
            "type": "object"
          }
        }
      },
      "arguments": {
        "seats": 2,
        "price": 19.5,
        "window": false,
        "note": null,
        "tags": [],
        "filters": {}
      },
      "invalid": []
    },
    {
