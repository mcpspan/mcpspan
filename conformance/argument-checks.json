    {
      "case": "a value no listed type allows",
      "schema": {
        "type": "object",
        "properties": {
          "return": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "arguments": {
        "return": 7
      },
      "invalid": [
        "return"
      ]
    },
    {
      "case": "enum and const, matched, an object among them",
      "schema": {
        "type": "object",
        "properties": {
          "cabin": {
            "enum": [
              "economy",
              "business",
              {
                "class": "first"
              }
            ]
          },
          "currency": {
            "const": "EUR"
          }
        }
      },
      "arguments": {
        "cabin": {
          "class": "first"
        },
        "currency": "EUR"
      },
      "invalid": []
    },
    {
      "case": "enum and const, missed",
      "schema": {
        "type": "object",
        "properties": {
          "cabin": {
            "enum": [
              "economy",
              "business",
              {
                "class": "first"
              }
            ]
          },
          "currency": {
            "const": "EUR"
          }
        }
      },
      "arguments": {
        "cabin": "premium",
        "currency": "USD"
      },
      "invalid": [
        "cabin",
        "currency"
      ]
    },
    {
      "case": "numbers within their bounds, an old-style boolean bound ignored",
      "schema": {
        "type": "object",
        "properties": {
          "seats": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "hours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 24
          },
          "legacy": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          }
        }
      },
      "arguments": {
        "seats": 9,
        "hours": 23.5,
        "legacy": 0
      },
      "invalid": []
    },
    {
      "case": "numbers out of their bounds",
      "schema": {
        "type": "object",
        "properties": {
          "seats": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "hours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 24
          },
          "legacy": {
            "type": "number",
            "minimum": 0,
