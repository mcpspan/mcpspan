          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "emoji": {
            "type": "string",
            "maxLength": 1
          },
          "legs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2
          }
        }
      },
      "arguments": {
        "code": "LIS",
        "emoji": "🛫",
        "legs": [
          "LIS-WAW"
        ]
