    },
    {
      "case": "nested objects and arrays that match",
      "schema": {
        "type": "object",
        "properties": {
          "passengers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "age": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "contact": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              }
            },
            "required": [
              "email"
            ]
          }
        }
      },
      "arguments": {
        "passengers": [
          {
            "name": "Ada",
            "age": 36
          }
        ],
        "contact": {
          "email": "a@example.com"
        }
      },
      "invalid": []
    },
    {
      "case": "a problem deep inside names the top-level argument it is in",
      "schema": {
        "type": "object",
        "properties": {
          "passengers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "age": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "contact": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              }
            },
            "required": [
              "email"
            ]
          }
        }
      },
      "arguments": {
        "passengers": [
          {
            "name": "Ada"
          },
          {
            "age": -1
          }
        ],
        "contact": {}
      },
      "invalid": [
        "contact",
        "passengers"
      ]
    },
    {
      "case": "what is not checked never fails",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "format": "iata"
          },
          "when": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "ref": {
            "$ref": "#/$defs/x"
          },
          "not": {
            "not": {
              "type": "string"
            }
          },
          "all": {
            "allOf": [
              {
                "type": "integer"
              }
            ]
          }
        }
      },
      "arguments": {
        "code": "lisbon",
        "when": true,
        "ref": 5,
        "not": "x",
        "all": "x"
      },
      "invalid": []
    },
    {
      "case": "a keyword whose value is not of the kind it takes is not checked",
      "schema": {
