{
  "name": "@mcpspan/core-api",
  "version": "0.1.0",
  "private": true,
  "description": "Ingest and aggregation API for mcpspan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts up",
    "migrate:down": "node --env-file-if-exists=../../.env scripts/migrate.ts down",
    "migrate:create": "node-pg-migrate create -j sql",
    "key:create": "node --env-file-if-exists=../../.env scripts/create-api-key.ts",
    "password:reset": "node --env-file-if-exists=../../.env scripts/reset-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "mcpspan": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
