{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The tests reach into apps/core-api for a real API; nothing is emitted, tsdown builds.
    "rootDir": "../..",
    "outDir": "./dist",
    "types": ["node"],
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"]
}
