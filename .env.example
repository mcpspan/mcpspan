# Optional. The stack runs without a .env at all; copy this file to .env only to
# change something. Never commit .env.
#
# Two sets of settings live here. Those under "Docker Compose" configure the
# self-hosted stack. Those under "Running from the repository" are for working
# on the code with `pnpm dev`, where the apps run on your machine and only the
# database is in a container. Compose does not read the second set: inside the
# stack, services find each other by service name, and an address pointing at
# localhost would send them nowhere.


# --- Docker Compose ---

# Mixed into API key hashes before they are stored. Leave it empty and the API
# makes one on first start and keeps it on its own Docker volume. Set it to
# supply your own instead, generated once and then left alone: changing it
# invalidates every key ever issued.
#
#   openssl rand -hex 32
API_KEY_SECRET=

# Where the SDK should send telemetry, as the outside world reaches this
# installation. Shown in the setup snippet in the dashboard. Leave it unset
# while everything is on one machine; set it to your real address once the
# stack is somewhere else, for instance https://mcpspan.example.com.
#
# Read when a page renders, so changing it is a restart, not a rebuild.
MCPSPAN_INGEST_URL=

# How long raw events are kept, in days. Past this they are dropped and the
# questions that need them - the error list with its messages, and any window
# narrower than an hour - stop reaching further back. Everything else is
# answered from an hourly rollup, which is kept far longer.
#
# Not settable below 8 days: the rollup is refreshed from a seven day window,
# and dropping raw rows inside it would have correct figures recomputed as
# zeroes. A value under the floor is refused and said so on stderr, not
# silently rounded up.
MCPSPAN_RETENTION_DAYS=90

# How long the hourly rollup is kept. This is what long windows are drawn
# from, and it is smaller than the raw events by a factor of thirty or so, so
# there is little reason to make it short.
MCPSPAN_ROLLUP_RETENTION_DAYS=730

# How fast one server may write, in events per second sustained. Charged by
# the event rather than by the request, because one batch can carry a thousand
# of them. Ten times what a busy MCP server produces, so it should never be
# felt; it exists to stop a runaway loop or a leaked key filling a disk.
MCPSPAN_INGEST_EVENTS_PER_SECOND=100

# How much a server may deliver at once after being idle or cut off. Twice the
# SDK's own queue, so a server coming back from an outage empties its backlog
# in one go instead of being metered through it. Going over this is answered
# with 429 and a Retry-After, which the SDK treats as worth retrying, so
# nothing is lost - it just arrives later.
MCPSPAN_INGEST_BURST_EVENTS=20000

# Forward every call to OpenTelemetry as well: one span per call and a
# duration histogram, in OpenTelemetry's names for MCP servers. Off while
# unset. OTLP over HTTP only (port 4318 on a Collector), and as the API's
# container reaches it: inside the stack, localhost is the API itself.
# OTEL_EXPORTER_OTLP_HEADERS takes a vendor's key, as key=value,key=value.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Published ports. 6270 is MCP on a telephone keypad. Deliberately not 3000 or
# 8080: whoever runs this is already running an MCP server of their own, and
# those ports are usually taken. Change them if they collide anyway.
CORE_DASHBOARD_PORT=6270
CORE_API_PORT=6271
POSTGRES_PORT=6272

# Where the dashboard and the API listen. Empty means every interface, which
# is what MCP servers on other machines, in containers or on your network need
# to reach the API. Set 127.0.0.1 to keep both to this machine alone, when the
# MCP servers you measure run here too, outside containers. The database is
# always kept to this machine.
MCPSPAN_BIND_ADDRESS=

# Database credentials. Worth changing before putting this anywhere that is
# not your own machine.
POSTGRES_USER=mcpspan
POSTGRES_PASSWORD=mcpspan
POSTGRES_DB=mcpspan


# --- Running from the repository (pnpm dev) ---

# PostgreSQL with the TimescaleDB extension enabled. This is the host-side
# address: `docker compose up -d db` publishes the database on localhost.
DATABASE_URL=postgres://mcpspan:mcpspan@localhost:6272/mcpspan

PORT=6271

# Where the dashboard reaches the Core API. Server side only, and deliberately
# not prefixed NEXT_PUBLIC_: the browser never talks to the Core API directly,
# because that would mean exposing it to the network. The dashboard forwards
# each reader's own session cookie instead.
CORE_API_URL=http://localhost:6271

# Sessions are kept in the database rather than signed into a cookie, so there
# is no signing secret to set. Signing out ends a session for real.


# --- SDK (local test servers only) ---

# API key issued by the dashboard, read by the mcpspan SDK.
MCPSPAN_API_KEY=

# Telemetry destination. Point this at your Core API.
MCPSPAN_ENDPOINT=http://localhost:6271
